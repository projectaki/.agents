#!/usr/bin/env python3
"""A fake `rex` for the terminal tests.

Environment:
  FAKE_REX_STATE   folder for its state
  FAKE_REX_SERVER  "1": a server is reachable; anything else: none

Without `--autostart=false`, real rex starts a server; this fake writes
`server-started` instead, so a test can prove x-env never does that.
`new` runs the command detached, with REX_SESSION set, like a Rex session;
`kill` sends it SIGHUP, like `rex kill`.

With `-S <host>` (the host transport), `new` runs the command to the end in
the home folder, its stdout and stderr mixed in one file, as a terminal
shows them; `wait` prints `{"exit_code": n}` and exits n; `capture` prints
the output; `kill` closes it. A missing program gives the shell's
"not found" and 127, as Rex does. More environment for this mode:
  FAKE_REX_WAIT    "lost": wait fails without an exit code;
                   "hang": wait sleeps until it is interrupted
"""
import json
import os
import signal
import subprocess
import sys
import time
from pathlib import Path

state = Path(os.environ["FAKE_REX_STATE"])
args = sys.argv[1:]
with open(state / "calls.jsonl", "a") as calls:
    calls.write(json.dumps(args) + "\n")
if "--autostart=false" in args:
    args.remove("--autostart=false")
else:
    (state / "server-started").touch()
if os.environ.get("FAKE_REX_SERVER") != "1":
    print("Error: no server", file=sys.stderr)
    sys.exit(1)

host = None
if args[0] == "-S":
    host = args[1]
    args = args[2:]


def host_mode(command):
    if command == "new":
        argv = args[args.index("--") + 1:]
        number = len(list(state.glob("session-*"))) + 1
        output = state / f"output-{number}"
        with open(output, "w") as screen:
            try:
                status = subprocess.run(argv, cwd=Path.home(), stdin=subprocess.DEVNULL,
                                        stdout=screen, stderr=subprocess.STDOUT).returncode
            except FileNotFoundError:
                screen.write(f"rex-run: line 1: exec: {argv[0]}: not found\n")
                status = 127
        (state / f"session-{number}").write_text(json.dumps({"label": args[1], "exit": status}))
        print(json.dumps({"session_id": f"session:fake-{number}",
                          "initial_windows": [{"block_ids": [f"block:fake-{number}"]}]}))
        sys.exit(0)
    if command == "wait":
        if os.environ.get("FAKE_REX_WAIT") == "hang":
            time.sleep(60)
        if os.environ.get("FAKE_REX_WAIT") == "lost":
            print("Error: connection lost", file=sys.stderr)
            sys.exit(1)
        number = args[-1].removeprefix("block:fake-")
        status = json.loads((state / f"session-{number}").read_text())["exit"]
        print(json.dumps({"exit_code": status}))
        sys.exit(status)
    if command == "capture":
        number = args[args.index("-s") + 1].removeprefix("session:fake-")
        sys.stdout.write((state / f"output-{number}").read_text())
        sys.exit(0)
    if command == "kill":
        path = state / f"session-{args[1].removeprefix('session:fake-')}"
        if not path.exists() or path.read_text() == "killed":
            sys.exit(3)
        path.write_text("killed")
        sys.exit(0)
    sys.exit(2)


command = args[0]
if host is not None:
    host_mode(command)
if command == "ls":
    sys.exit(0)
if command == "new":
    label, cwd = args[1], args[args.index("--cwd") + 1]
    argv = args[args.index("--") + 1:]
    number = len(list(state.glob("session-*"))) + 1
    session_id = f"session:fake-{number}"
    process = subprocess.Popen(argv, cwd=cwd, env={**os.environ, "REX_SESSION": session_id},
                               start_new_session=True, stdin=subprocess.DEVNULL,
                               stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    (state / f"session-{number}").write_text(json.dumps({"label": label, "pid": process.pid}))
    print(json.dumps({"session_id": session_id}))
    sys.exit(0)
if command == "kill":
    path = state / f"session-{args[1].removeprefix('session:fake-')}"
    if not path.exists() or path.read_text() == "killed":
        print(f'Error: session target "{args[1]}" not found', file=sys.stderr)
        sys.exit(3)
    os.kill(json.loads(path.read_text())["pid"], signal.SIGHUP)
    path.write_text("killed")
    sys.exit(0)
sys.exit(2)
