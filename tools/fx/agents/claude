#!/usr/bin/env bash
set -euo pipefail

if [[ "${1-}" == check ]]; then
  command -v claude >/dev/null
  exit
fi

project="$2"
session="$4"
reasoning="$5"
shift 5
[[ $# == 0 ]] || set -- -- "$1"
printf 'model=claude-opus-5-5\n' >> "$session/launch.txt"
unset CLAUDE_CODE_EFFORT_LEVEL
exec claude \
  --model claude-opus-5-5 \
  --effort "$reasoning" \
  --append-system-prompt-file "$session/instructions.md" \
  --add-dir "$project/project_context" \
  "$@"
