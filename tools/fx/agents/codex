#!/usr/bin/env bash
set -euo pipefail

if [[ "${1-}" == check ]]; then
  command -v codex >/dev/null
  exit
fi

project="$2"
task="$3"
session="$4"
reasoning="$5"
adapter_dir="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd -P)"
events_dir="$(python3 "$adapter_dir/../fx_events.py" "$session" codex-session.jsonl)"
codex --version > "$events_dir/harness-version.txt"
export CODEX_TUI_RECORD_SESSION=1
export CODEX_TUI_SESSION_LOG_PATH="$events_dir/codex-session.jsonl"
export FX_SESSION_CONTEXT_DIR="$session"
capture_config="$(python3 "$adapter_dir/codex_capture.py" config "$session")"
hook_config="$(python3 "$adapter_dir/codex_capture.py" hooks-config "$session")"
hook_args=()
while IFS= read -r setting; do
  hook_args+=(-c "$setting")
done <<< "$hook_config"
shift 5
[[ $# == 0 ]] || set -- -- "$1"
instructions="$(cat "$session/instructions.md")"
instructions="${instructions//\\/\\\\}"
instructions="${instructions//\"/\\\"}"
instructions="${instructions//$'\n'/\\n}"
instructions="${instructions//$'\r'/\\r}"
instructions="${instructions//$'\t'/\\t}"
printf 'model=gpt-6.1-sol\n' >> "$session/launch.txt"
exec codex \
  --cd "$task" \
  --model gpt-6.1-sol \
  -c "model_reasoning_effort=\"$reasoning\"" \
  -c "developer_instructions=\"$instructions\"" \
  --add-dir "$project/project_context" \
  -c "$capture_config" \
  --no-daemon \
  "${hook_args[@]}" \
  "$@"
